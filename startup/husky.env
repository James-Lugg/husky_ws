# Use exact /dev/serial/by-id/... paths, or serial-number-based udev aliases.
# Never use ttyUSB0/ttyUSB1: their order changes across boots.
IMU_DEVICE=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
A200_DEVICE=/dev/serial/by-id/usb-Prolific_Technology_Inc._USB-Serial_Controller_D-if00-port0
ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET


