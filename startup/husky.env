# lrwxrwxrwx 1 root root 13 Oct 20 05:43 usb-1a86_USB_Serial-if00-port0 -> ../../ttyUSB0
# lrwxrwxrwx 1 root root 13 Oct 20 05:43 usb-Prolific_Technology_Inc._USB-Serial_Controller_D-if00-port0 -> ../../ttyUSB1

