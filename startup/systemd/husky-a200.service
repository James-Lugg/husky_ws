[Unit]
Description=Husky A200 serial server
Wants=network-online.target
After=network-online.target
PartOf=husky.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=robot
SupplementaryGroups=dialout
WorkingDirectory=/home/robot/husky_ws
Environment=HOME=/home/robot
EnvironmentFile=/etc/husky/husky.env
ExecStart=/home/robot/husky_ws/startup/run-node a200
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=husky.target
